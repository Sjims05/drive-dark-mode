{
  "manifest_version": 3,
  "name": "Drive Dark Mode",
  "version": "0.5.0",
  "description": "Dark mode for Google Drive, Docs, Sheets and Slides, including the page in Docs and the grid in Sheets.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "drive-dark-mode@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Drive Dark Mode",
    "default_icon": "icons/icon.svg",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "run_at": "document_start",
      "css": [
        "src/styles/palette.css",
        "src/styles/editor-tokens.css",
        "src/styles/editor-ui.css",
        "src/styles/docs.css"
      ],
      "js": ["src/settings.js", "src/content/boot.js"]
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "run_at": "document_start",
      "css": [
        "src/styles/palette.css",
        "src/styles/editor-tokens.css",
        "src/styles/editor-ui.css",
        "src/styles/sheets.css"
      ],
      "js": ["src/settings.js", "src/content/boot.js"]
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "run_at": "document_start",
      "css": [
        "src/styles/palette.css",
        "src/styles/editor-tokens.css",
        "src/styles/editor-ui.css",
        "src/styles/slides.css"
      ],
      "js": ["src/settings.js", "src/content/boot.js"]
    },
    {
      "matches": [
        "https://docs.google.com/drivesharing/*",
        "https://docs.google.com/picker/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": ["src/styles/palette.css", "src/styles/dialog-frame.css"],
      "js": ["src/settings.js", "src/content/boot.js"]
    },
    {
      "matches": ["https://drive.google.com/*"],
      "run_at": "document_start",
      "css": ["src/styles/palette.css", "src/styles/drive.css"],
      "js": ["src/settings.js", "src/content/boot.js"]
    }
  ]
}
